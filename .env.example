# PostHog product analytics (anonymous, EU region). Optional: if unset, the app
# runs fine and analytics is disabled (a one-line note is logged to the console).
#
# Both are PUBLIC, client-side values (all VITE_* vars are inlined into the
# shipped bundle). The key is a PostHog *project* key — write-only ingestion,
# safe to expose. Set these in your local .env and in the CI/release build env.
VITE_POSTHOG_KEY=phc_your_project_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com
